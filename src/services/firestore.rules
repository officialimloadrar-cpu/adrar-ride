rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() { return request.auth != null; }
    function owner(uid) { return authed() && request.auth.uid == uid; }
    function firstAccept() {
      return resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && resource.data.driverId == null
        && request.resource.data.driverId != null;
    }
    function driverOwns() {
      return authed()
        && resource.data.driverId == request.auth.uid
        && request.resource.data.driverId == resource.data.driverId;
    }

    match /activeRides/{rideId} {
      allow read: if true;
      allow create: if request.resource.data.userId != null;
      allow update: if resource.data.userId == request.resource.data.userId;
      allow update: if firstAccept();
      allow update: if driverOwns();
    }

    match /colis_orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.userId != null;
      allow update: if firstAccept();
      allow update: if driverOwns();
    }

    match /{coll}/{id} where coll in [
      'corsa_orders','light_orders','hilux_orders','fleet_orders',
      'fellah_orders','bouteille_orders','pharma_orders',
      'documents_orders','demenagement_orders','voyage_orders'
    ] {
      allow create, read: if authed();
      allow update: if firstAccept();
      allow update: if driverOwns();
    }

    match /drivers/{driverId} {
      allow read: if authed();
      allow write: if owner(driverId);
    }
  }
}